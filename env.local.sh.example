# Copy to env.local.sh (git-ignored) and set the paths for your machine; env.sh sources it.

# Model weights (Hugging Face cache), run outputs (runs/) and the specialists' third-party code (third_party/).
export EOJEV_MODELS_ROOT=/path/to/eo-jev-data
# Datasets: raw downloads (raw/) and the converted row files every model is evaluated on (converted/), ~200 GB.
export EOJEV_DATASETS=/path/to/eo-jev-datasets
# Folder for the conda envs made by scripts/setup_env.sh (eojev) and scripts/setup_specialist_envs.sh (eo-*).
export EOJEV_ENVS=/path/to/envs

# Optional
# export EOJEV_CONDA=$HOME/miniconda3          # conda install (default $HOME/miniconda3)
# When $HOME is small, keep the pip and conda package caches elsewhere (CONDA_PKGS_DIRS also avoids races between
# parallel env builds in a shared ~/miniconda3/pkgs):
# export PIP_CACHE_DIR=/path/to/pip_cache
# export CONDA_PKGS_DIRS=/path/to/conda_pkgs
